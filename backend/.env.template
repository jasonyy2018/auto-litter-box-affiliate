# Medusa Backend — Configuration
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/auto_litter_medusa

# Medusa Admin
MEDUSA_ADMIN_ONLY=false
MEDUSA_ADMIN_CORS=http://localhost:9000,http://localhost:8000
STORE_CORS=http://localhost:3000

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# Redis (optional — for high performance)
# REDIS_URL=redis://localhost:6379

# PayPal (Sandbox defaults)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# SendGrid (Email notifications)
SENDGRID_API_KEY=
SENDGRID_FROM=notifications@autolitterboxpro.com

# CJ Dropshipping (Custom Fulfillment)
CJ_API_KEY=
CJ_EMAIL=

# Site URL
NEXT_PUBLIC_SITE_URL=https://autolitterboxpro.com
